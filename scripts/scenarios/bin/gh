#!/usr/bin/env python3
"""A stand-in for the GitHub CLI in the scenarios: answers from the JSON file
in $FAKE_GH_STATE ({"login", "pr": {...gh pr view json...}, "comments": [...],
"reviews": [...]}) and fails anything else."""
import json, os, sys
args = sys.argv[1:]
state = json.load(open(os.environ["FAKE_GH_STATE"])) if os.path.exists(os.environ.get("FAKE_GH_STATE", "")) else {}
if args[:2] == ["api", "user"]:
    print(state.get("login", "kh"))
elif args[:2] == ["pr", "view"]:
    print(json.dumps(state.get("pr", {})))
elif args[:1] == ["api"] and args[-1].endswith("/comments"):
    print(json.dumps(state.get("comments", [])))
elif args[:1] == ["api"] and args[-1].endswith("/reviews"):
    print(json.dumps(state.get("reviews", [])))
else:
    print("fake gh: not scripted: " + " ".join(args), file=sys.stderr)
    sys.exit(1)
